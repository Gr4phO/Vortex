// Test FFI C Natif Dynamique pour Vortex (Linux POSIX)

extern "libc.so.6" fn puts(s: str) -> i32;
extern "libc.so.6" fn abs(n: i64) -> i64;
extern "libc.so.6" fn strlen(s: str) -> i64;
extern "libm.so.6" fn pow(x: f64, y: f64) -> f64;
extern "libm.so.6" fn sqrt(x: f64) -> f64;

struct TextBuffer {
    w0: i64,
    w1: i64,
    w2: i64,
    w3: i64
}

extern "libc.so.6" fn memset(dst: ptr, ch: i32, n: i64) -> ptr;

unsafe {
    puts("--- [POSIX FFI TEST: libc.so.6 + libm.so.6] ---");
    print(abs(-42));
    print(pow(2.0, 10.0));
    print(sqrt(144.0));
    print(strlen("Vortex"));

    let tb = TextBuffer { w0: 0, w1: 0, w2: 0, w3: 0 };
    memset(tb, 65, 8);
    puts(tb);
    puts("--- [ALL POSIX FFI TESTS COMPLETED] ---");
}
