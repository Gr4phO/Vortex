// Comprehensive test for Vortex v1.2 ergonomics & type/syntax upgrades

enum Role {
    Guest,
    Member = 10,
    Admin = 42
}

struct Vec2 {
    x: f32,
    y: f32
}

struct Player {
    role: Role,
    active: bool,
    tag: char,
    pos: Vec2
}

struct World {
    tick: u64,
    checksum: u32,
    player: Player
}

fn check_role_bool(r: Role, active: bool) -> i64 {
    let mut score: i64 = 0;
    match r {
        Role::Guest => score = 1,
        Role::Member | Role::Admin => {
            score = active ? 100 : 50;
        },
        _ => score = -1
    }
    return score;
}

fn test_types_and_literals() -> i64 {
    let ok: bool = true;
    let nope: bool = false;
    let big: u64 = 1_000_000;
    let bits: u8 = 0b1010_0101;
    let perm: u16 = 0o755;
    let ch: char = 'A';
    let nl: char = '\n';
    let small: i8 = -5;
    let med: i16 = 300;
    let port: u32 = 8080 as u32;
    let idx: usize = 12;
    let off: isize = -3;
    let sci: f32 = 1.5e2;

    assert_eq(ok, 1);
    assert_eq(nope, 0);
    assert_eq(big, 1000000);
    assert_eq(bits, 165);
    assert_eq(perm, 493);
    assert_eq(ch, 65);
    assert_eq(nl, 10);
    assert_eq(small + med, 295);
    assert_eq(port as i64, 8080);
    assert_eq(idx + off, 9);
    assert(sci > 149.9 && sci < 150.1);
    return 0;
}

fn test_array_literals_and_ternary() -> i64 {
    let nums = [10, 20, 30, 40];
    assert_eq(slice_len(nums), 4);
    assert_eq(nums[0] + nums[3], 50);

    let floats = [1.5, 2.5, 3.0];
    assert_eq(slice_len(floats), 3);
    assert((floats[0] + floats[1]) > 3.9);

    let x = 7;
    let sign = x > 0 ? (x > 5 ? 2 : 1) : 0;
    assert_eq(sign, 2);

    let f_val: f32 = x == 7 ? 3.5 : 1.0;
    assert(f_val > 3.4 && f_val < 3.6);
    return 0;
}

fn test_match_and_nested_writes() -> i64 {
    assert_eq(check_role_bool(Role::Guest, true), 1);
    assert_eq(check_role_bool(Role::Admin, true), 100);
    assert_eq(check_role_bool(Role::Member, false), 50);

    let v = Vec2 { x: 1.0, y: 2.0 };
    let p = Player { role: Role::Admin, active: true, tag: 'V', pos: v };
    let w = World { tick: 0, checksum: 1 as u32, player: p };

    // Chained multi-level field write + compound assignment!
    w.player.pos.x = 10.0;
    w.player.pos.x += 5.5;
    w.player.tag = 'X';
    w.tick += 1;

    assert(w.player.pos.x > 15.4 && w.player.pos.x < 15.6);
    assert_eq(w.player.tag, 88);
    assert_eq(w.tick, 1);
    return 0;
}

test_types_and_literals();
test_array_literals_and_ternary();
test_match_and_nested_writes();
print_str("[PASS] test_v12_features OK\n");
