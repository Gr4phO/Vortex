{
  "name": "vortex-systems",
  "displayName": "Vortex Systems Language (.vx)",
  "description": "One-click Run in Terminal, syntax highlighting, --ultrasafe checks, REPL, and native LSP support for the Vortex systems language.",
  "version": "1.1.8",
  "publisher": "Gr4phO",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "homepage": "https://github.com/Gr4phO/Vortex#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gr4phO/Vortex.git"
  },
  "bugs": {
    "url": "https://github.com/Gr4phO/Vortex/issues"
  },
  "keywords": [
    "vortex",
    "systems",
    "jit",
    "arena",
    "ultrasafe",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:vortex",
    "workspaceContains:**/*.vx",
    "onCommand:vortex.runFile",
    "onCommand:vortex.runFileRelease",
    "onCommand:vortex.checkFileUltrasafe",
    "onCommand:vortex.runTests",
    "onCommand:vortex.buildStandalone",
    "onCommand:vortex.openRepl",
    "onCommand:vortex.restartLsp"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vortex",
        "aliases": [
          "Vortex",
          "vortex"
        ],
        "extensions": [
          ".vx"
        ],
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vortex",
        "scopeName": "source.vortex",
        "path": "./syntaxes/vortex.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "vortex-icons",
        "label": "Vortex File Icons",
        "path": "./themes/vortex-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "vortex.runFile",
        "title": "Run Vortex File in Terminal",
        "category": "Vortex",
        "icon": "$(play)"
      },
      {
        "command": "vortex.runFileRelease",
        "title": "Run Vortex File (--release)",
        "category": "Vortex",
        "icon": "$(flame)"
      },
      {
        "command": "vortex.checkFileUltrasafe",
        "title": "Check File (--ultrasafe 3 --check)",
        "category": "Vortex",
        "icon": "$(shield)"
      },
      {
        "command": "vortex.runTests",
        "title": "Run Native Tests (vortex test)",
        "category": "Vortex",
        "icon": "$(beaker)"
      },
      {
        "command": "vortex.buildStandalone",
        "title": "Build Standalone Executable",
        "category": "Vortex",
        "icon": "$(package)"
      },
      {
        "command": "vortex.openRepl",
        "title": "Open Interactive Vortex REPL",
        "category": "Vortex",
        "icon": "$(terminal)"
      },
      {
        "command": "vortex.restartLsp",
        "title": "Restart Language Server",
        "category": "Vortex",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "vortex.runFile",
          "when": "editorLangId == vortex || resourceLangId == vortex || resourceExtname == .vx",
          "group": "navigation@0"
        },
        {
          "command": "vortex.runFileRelease",
          "when": "editorLangId == vortex || resourceLangId == vortex || resourceExtname == .vx",
          "group": "navigation@1"
        },
        {
          "command": "vortex.checkFileUltrasafe",
          "when": "editorLangId == vortex || resourceLangId == vortex || resourceExtname == .vx",
          "group": "navigation@2"
        },
        {
          "command": "vortex.runTests",
          "when": "editorLangId == vortex || resourceLangId == vortex || resourceExtname == .vx",
          "group": "navigation@3"
        },
        {
          "command": "vortex.buildStandalone",
          "when": "editorLangId == vortex || resourceLangId == vortex || resourceExtname == .vx",
          "group": "navigation@4"
        },
        {
          "command": "vortex.openRepl",
          "when": "editorLangId == vortex || resourceLangId == vortex || resourceExtname == .vx",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "command": "vortex.runFile",
          "when": "editorLangId == vortex || resourceLangId == vortex || resourceExtname == .vx",
          "group": "navigation@1"
        },
        {
          "command": "vortex.runFileRelease",
          "when": "editorLangId == vortex || resourceLangId == vortex || resourceExtname == .vx",
          "group": "navigation@2"
        },
        {
          "command": "vortex.checkFileUltrasafe",
          "when": "editorLangId == vortex || resourceLangId == vortex || resourceExtname == .vx",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "vortex.runFile",
          "when": "resourceExtname == .vx || resourceLangId == vortex",
          "group": "navigation@1"
        },
        {
          "command": "vortex.runFileRelease",
          "when": "resourceExtname == .vx || resourceLangId == vortex",
          "group": "navigation@2"
        },
        {
          "command": "vortex.checkFileUltrasafe",
          "when": "resourceExtname == .vx || resourceLangId == vortex",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Vortex",
      "properties": {
        "vortex.serverPath": {
          "type": "string",
          "default": "vortex",
          "description": "Path to the Vortex compiler executable (or leave 'vortex' to auto-detect in PATH / workspace)."
        },
        "vortex.defaultRunMode": {
          "type": "string",
          "enum": [
            "safe",
            "release",
            "ultrasafe1",
            "ultrasafe2",
            "ultrasafe3"
          ],
          "default": "safe",
          "description": "Default safety/optimization mode used by the editor Run button."
        },
        "vortex.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save the active .vx file before running or checking it."
        },
        "vortex.clearTerminalBeforeRun": {
          "type": "boolean",
          "default": false,
          "description": "Clear the Vortex integrated terminal before running a new command."
        },
        "vortex.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "Enable the built-in Vortex Language Server (`vortex lsp`)."
        },
        "vortex.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and the Vortex LSP server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
