{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vortex",
  "scopeName": "source.vortex",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vortex",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vortex",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.vortex",
          "match": "#\\[[^\\]]*\\]"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.vortex",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vortex",
          "match": "\\\\."
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.vortex",
      "match": "'(\\\\['\"\\\\ntr0]|[^'\\\\])'"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.vortex",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.vortex",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.vortex",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.vortex",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.float.scientific.vortex",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9_]+\\b"
        },
        {
          "name": "constant.numeric.integer.vortex",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.vortex",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vortex",
          "match": "\\b(if|else|for|parallel_for|in|while|match|break|continue|return|import)\\b"
        },
        {
          "name": "keyword.other.vortex",
          "match": "\\b(fn|struct|enum|let|mut|extern|unsafe|as)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.vortex",
          "match": "\\b(i64|i32|i16|i8|u64|u32|u16|u8|usize|isize|bool|char|f32|f64|str|ptr|void)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.vortex",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.vortex",
          "match": "(=>|->|::|\\.\\.|<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<|>>|&&|\\|\\||==|!=|<=|>=|[+\\-*/%=<>!&|^~?:])"
        }
      ]
    }
  }
}
