// =============================================================================
// VORTEX v1.0.0 - 10-LANGUAGE BENCHMARK SUITE (5 IDENTICAL ALGORITHMIC TASKS)
// =============================================================================

struct Node {
    x: i64,
    y: i64,
    z: i64
}

fn fib(n: i64) -> i64 {
    if n <= 1 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn step_fn(a: i64, b: i64) -> i64 {
    let mut next: i64 = a + b;
    if next >= 1000003 {
        next = next - 1000003;
    }
    return next;
}

fn bench_task3(n3: i64) -> i64 {
    let sp3: i64 = scope_push();
    let nodes3: [Node] = slice_i64(n3);
    for i3 in 0..n3 {
        let nd: Node = Node { x: i3, y: i3 * 2, z: i3 + 5 };
        nodes3[i3] = nd;
    }
    let mut sum3: i64 = 0;
    for i3b in 0..n3 {
        let p: Node = nodes3[i3b];
        sum3 = sum3 + p.x + p.y + p.z;
    }
    scope_pop(sp3);
    return sum3;
}

let t_all_0: i64 = time_us();

// -----------------------------------------------------------------------------
// TASK 1: SIMD & Pure Floating-Point (Riemann Pi, 100,000,000 iterations, f32)
// -----------------------------------------------------------------------------
let n1: i64 = 100000000;
let step1: f32 = 0.00000001;
let mut sum1: f32 = 0.0;
let mut x1: f32 = 0.000000005;

let t1_0: i64 = time_us();
for i1 in 0..n1 {
    sum1 = sum1 + 4.0 / (1.0 + x1 * x1);
    x1 = x1 + step1;
}
let t1_1: i64 = time_us();
let pi1: f32 = sum1 * step1;
let us1: i64 = t1_1 - t1_0;

// -----------------------------------------------------------------------------
// TASK 2: Memory Bandwidth & Vector Reduction (50,000,000 i64 elements)
// -----------------------------------------------------------------------------
let n2: i64 = 50000000;
let t2_0: i64 = time_us();
let arr2: *i64 = slice_i64(n2);
let mut cur2: i64 = 1;
for i2 in 0..n2 {
    cur2 = cur2 + 7;
    if cur2 >= 1024 {
        cur2 = cur2 - 1024;
    }
    arr2[i2] = cur2;
}
let mut sum2: i64 = 0;
for i2b in 0..n2 {
    let v2: i64 = arr2[i2b] * 3 + 1;
    arr2[i2b] = v2;
    sum2 = sum2 + v2;
}
let t2_1: i64 = time_us();
let us2: i64 = t2_1 - t2_0;

// -----------------------------------------------------------------------------
// TASK 3: Massive Memory Allocation (1,000,000 Node structs + full reduction)
// -----------------------------------------------------------------------------
let n3: i64 = 1000000;
let t3_0: i64 = time_us();
let sum3: i64 = bench_task3(n3);
let t3_1: i64 = time_us();
let us3: i64 = t3_1 - t3_0;

// -----------------------------------------------------------------------------
// TASK 4: Function Calls & Intensive Recursion (fib(40) + 100M step_fn calls)
// -----------------------------------------------------------------------------
let t4_0: i64 = time_us();
let f40: i64 = fib(40);
let mut acc4: i64 = 0;
let n4: i64 = 100000000;
for i4 in 0..n4 {
    acc4 = step_fn(acc4, 7919);
}
let t4_1: i64 = time_us();
let chk4: i64 = f40 + acc4;
let us4: i64 = t4_1 - t4_0;

// -----------------------------------------------------------------------------
// TASK 5: Multi-Core Parallelism (2000 x 50000 = 100,000,000 cells across cores)
// -----------------------------------------------------------------------------
let rows5: i64 = 2000;
let cols5: i64 = 50000;
let t5_0: i64 = time_us();
let row_sums: *i64 = slice_i64(rows5);
parallel_for r5 in 0..rows5 {
    let mut acc5: i64 = r5;
    for c5 in 0..cols5 {
        acc5 = acc5 + 7919;
        if acc5 >= 1000003 {
            acc5 = acc5 - 1000003;
        }
    }
    row_sums[r5] = acc5;
}
let mut sum5: i64 = 0;
for r5b in 0..rows5 {
    sum5 = sum5 + row_sums[r5b];
}
let t5_1: i64 = time_us();
let us5: i64 = t5_1 - t5_0;

let us_total: i64 = time_us() - t_all_0;

print_str("TASK1_US ");
print(us1);
print_str("TASK1_PI ");
print(pi1);
print_str("TASK2_US ");
print(us2);
print_str("TASK2_CHK ");
print(sum2);
print_str("TASK3_US ");
print(us3);
print_str("TASK3_CHK ");
print(sum3);
print_str("TASK4_US ");
print(us4);
print_str("TASK4_CHK ");
print(chk4);
print_str("TASK5_US ");
print(us5);
print_str("TASK5_CHK ");
print(sum5);
print_str("TOTAL_US ");
print(us_total);
