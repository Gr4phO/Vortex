// Vortex Standard Library: std/gpu
// Optional GPU Compute/Rendering FFI module (Vulkan / DX12 / Metal) + Vortex SIMD parallel fallback.

struct GpuInfo {
    backend: str,        // "vulkan", "dx12", "metal", or "cpu_simd"
    driver_loaded: i64,
    device_count: i64,
    device_name: str,
    status: i64
}

fn gpu_i32_sext(v: i64) -> i64 {
    let mut u = v % 4294967296;
    if u < 0 {
        u = u + 4294967296;
    }
    if u >= 2147483648 {
        return u - 4294967296;
    }
    return u;
}

fn gpu_cstr_alloc(s: str) -> i64 {
    let n = str_len(s);
    unsafe {
        let p = alloc(n + 1);
        let mut i = 0;
        while i < n {
            ptr_write8(p + i, str_byte(s, i));
            i = i + 1;
        }
        ptr_write8(p + n, 0);
        return p;
    }
}

#[cfg(windows)]
fn gpu_load_vulkan() -> i64 {
    unsafe {
        return ffi_load("vulkan-1.dll");
    }
}

#[cfg(linux)]
fn gpu_load_vulkan() -> i64 {
    unsafe {
        let h1 = ffi_load("libvulkan.so.1");
        if h1 != 0 {
            return h1;
        }
        return ffi_load("libvulkan.so");
    }
}

#[cfg(macos)]
fn gpu_load_vulkan() -> i64 {
    unsafe {
        let h1 = ffi_load("libvulkan.1.dylib");
        if h1 != 0 {
            return h1;
        }
        return ffi_load("libMoltenVK.dylib");
    }
}

#[cfg(windows)]
fn gpu_dx12_available() -> i64 {
    unsafe {
        let h = ffi_load("d3d12.dll");
        if h != 0 {
            return 1;
        }
        return 0;
    }
}

#[cfg(unix)]
fn gpu_dx12_available() -> i64 {
    return 0;
}

#[cfg(macos)]
fn gpu_metal_available() -> i64 {
    unsafe {
        let h = ffi_load("/System/Library/Frameworks/Metal.framework/Metal");
        if h != 0 {
            return 1;
        }
        return 0;
    }
}

#[cfg(windows)]
fn gpu_metal_available() -> i64 {
    return 0;
}

#[cfg(linux)]
fn gpu_metal_available() -> i64 {
    return 0;
}

fn gpu_vulkan_available() -> i64 {
    if gpu_load_vulkan() != 0 {
        return 1;
    }
    return 0;
}

fn gpu_probe() -> GpuInfo {
    let vk = gpu_load_vulkan();
    if vk != 0 {
        unsafe {
            let fn_create = ffi_symbol(vk, "vkCreateInstance");
            let fn_enum = ffi_symbol(vk, "vkEnumeratePhysicalDevices");
            let fn_props = ffi_symbol(vk, "vkGetPhysicalDeviceProperties");
            let fn_destroy = ffi_symbol(vk, "vkDestroyInstance");
            if fn_create != 0 {
                let app_name = gpu_cstr_alloc("vortex_app");
                let eng_name = gpu_cstr_alloc("vortex_gpu");

                // VkApplicationInfo (48 bytes on 64-bit)
                let app_info = alloc(48);
                ptr_write32(app_info + 0, 0);          // VK_STRUCTURE_TYPE_APPLICATION_INFO
                ptr_write64(app_info + 8, 0);          // pNext
                ptr_write64(app_info + 16, app_name);  // pApplicationName
                ptr_write32(app_info + 24, 1);         // applicationVersion
                ptr_write64(app_info + 32, eng_name);  // pEngineName
                ptr_write32(app_info + 40, 1);         // engineVersion
                ptr_write32(app_info + 44, 4194304);   // VK_API_VERSION_1_0 (1 << 22)

                // VkInstanceCreateInfo (64 bytes on 64-bit)
                let ci = alloc(64);
                ptr_write32(ci + 0, 1);                // VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
                ptr_write64(ci + 8, 0);                // pNext
                ptr_write32(ci + 16, 0);               // flags
                ptr_write64(ci + 24, app_info);        // pApplicationInfo

                let p_inst = alloc(8);
                ptr_write64(p_inst, 0);
                let rc = gpu_i32_sext(ffi_call3(fn_create, ci, 0, p_inst));
                let inst = ptr_read64(p_inst);
                if rc == 0 {
                    if inst != 0 {
                        let mut dev_count = 0;
                        let mut dev_name = "Vulkan Device";
                        if fn_enum != 0 {
                            let p_cnt = alloc(4);
                            ptr_write32(p_cnt, 0);
                            let e1 = gpu_i32_sext(ffi_call3(fn_enum, inst, p_cnt, 0));
                            if e1 == 0 {
                                dev_count = gpu_i32_sext(ptr_read32(p_cnt));
                                if dev_count > 0 {
                                    let p_devs = alloc(dev_count * 8);
                                    let e2 = gpu_i32_sext(ffi_call3(fn_enum, inst, p_cnt, p_devs));
                                    if e2 == 0 {
                                        if fn_props != 0 {
                                            let dev0 = ptr_read64(p_devs);
                                            let props = alloc(1024);
                                            ffi_call2(fn_props, dev0, props);
                                            // VkPhysicalDeviceProperties.deviceName[256] starts at byte 20
                                            dev_name = ptr_to_str(props + 20);
                                        }
                                    }
                                }
                            }
                        }
                        if fn_destroy != 0 {
                            ffi_call2(fn_destroy, inst, 0);
                        }
                        return GpuInfo {
                            backend: "vulkan",
                            driver_loaded: 1,
                            device_count: dev_count,
                            device_name: dev_name,
                            status: 0
                        };
                    }
                }
                if gpu_dx12_available() == 1 {
                    return GpuInfo {
                        backend: "dx12",
                        driver_loaded: 1,
                        device_count: 1,
                        device_name: "DX12 Runtime (Vulkan ICD unavailable)",
                        status: rc
                    };
                }
                return GpuInfo {
                    backend: "vulkan",
                    driver_loaded: 1,
                    device_count: 0,
                    device_name: "Vulkan Loader (no ICD)",
                    status: rc
                };
            }
        }
    }
    if gpu_metal_available() == 1 {
        return GpuInfo {
            backend: "metal",
            driver_loaded: 1,
            device_count: 1,
            device_name: "Apple Metal Framework",
            status: 0
        };
    }
    if gpu_dx12_available() == 1 {
        return GpuInfo {
            backend: "dx12",
            driver_loaded: 1,
            device_count: 1,
            device_name: "Direct3D 12 Runtime",
            status: 0
        };
    }
    return GpuInfo {
        backend: "cpu_simd",
        driver_loaded: 0,
        device_count: 1,
        device_name: "Vortex parallel_for SIMD fallback",
        status: 0
    };
}

// Compute kernel abstraction: dispatches parallel SIMD kernel when GPU command queue is offloaded to host.
fn gpu_compute_saxpy(y: [f32], a: f32, x: [f32], n: i64) -> i64 {
    parallel_for i in 0..n {
        y[i] = a * x[i] + y[i];
    }
    return n;
}
