// Vortex Standard Library: std/json
// Zero-per-object-heap arena JSON parser and serializer (scope_push / scope_pop friendly)

struct JsonNode {
    kind: i64,      // 0=null, 1=bool, 2=int, 3=float_str, 4=str, 5=array, 6=object
    bool_val: i64,
    int_val: i64,
    str_val: str,
    arr: i64,       // vec of JsonNode (as i64)
    keys: i64,      // vec of str keys
    obj: i64        // map key -> JsonNode (as i64)
}

struct JsonCursor {
    src: str,
    len: i64,
    pos: i64
}

fn json_make_null() -> JsonNode {
    return JsonNode { kind: 0, bool_val: 0, int_val: 0, str_val: "null", arr: 0, keys: 0, obj: 0 };
}

fn json_make_bool(b: i64) -> JsonNode {
    let mut bv = 0;
    let mut sv = "false";
    if b != 0 {
        bv = 1;
        sv = "true";
    }
    return JsonNode { kind: 1, bool_val: bv, int_val: bv, str_val: sv, arr: 0, keys: 0, obj: 0 };
}

fn json_make_int(n: i64) -> JsonNode {
    return JsonNode { kind: 2, bool_val: 0, int_val: n, str_val: str_from_i64(n), arr: 0, keys: 0, obj: 0 };
}

fn json_make_float_str(raw: str) -> JsonNode {
    return JsonNode { kind: 3, bool_val: 0, int_val: str_to_i64(raw), str_val: raw, arr: 0, keys: 0, obj: 0 };
}

fn json_make_str(s: str) -> JsonNode {
    return JsonNode { kind: 4, bool_val: 0, int_val: 0, str_val: s, arr: 0, keys: 0, obj: 0 };
}

fn json_make_array() -> JsonNode {
    return JsonNode { kind: 5, bool_val: 0, int_val: 0, str_val: "", arr: vec_new(), keys: 0, obj: 0 };
}

fn json_make_object() -> JsonNode {
    return JsonNode { kind: 6, bool_val: 0, int_val: 0, str_val: "", arr: 0, keys: vec_new(), obj: map_new() };
}

fn json_push(arr_node: JsonNode, child: JsonNode) -> i64 {
    if arr_node.kind != 5 { return 0; }
    unsafe {
        vec_push(arr_node.arr, child as i64);
    }
    return vec_len(arr_node.arr);
}

fn json_set(obj_node: JsonNode, key: str, child: JsonNode) -> i64 {
    if obj_node.kind != 6 { return 0; }
    if map_has(obj_node.obj, key) == 0 {
        unsafe {
            vec_push(obj_node.keys, key as i64);
        }
    }
    unsafe {
        map_set(obj_node.obj, key, child as i64);
    }
    return 1;
}

fn json_len(node: JsonNode) -> i64 {
    if node.kind == 5 { return vec_len(node.arr); }
    if node.kind == 6 { return vec_len(node.keys); }
    return 0;
}

fn json_at(arr_node: JsonNode, idx: i64) -> JsonNode {
    if arr_node.kind != 5 { return json_make_null(); }
    if idx < 0 { return json_make_null(); }
    if idx >= vec_len(arr_node.arr) { return json_make_null(); }
    let raw = vec_get(arr_node.arr, idx);
    if raw == 0 { return json_make_null(); }
    unsafe {
        return raw as JsonNode;
    }
}

fn json_has(obj_node: JsonNode, key: str) -> i64 {
    if obj_node.kind != 6 { return 0; }
    return map_has(obj_node.obj, key);
}

fn json_get(obj_node: JsonNode, key: str) -> JsonNode {
    if obj_node.kind != 6 { return json_make_null(); }
    if map_has(obj_node.obj, key) == 0 { return json_make_null(); }
    let raw = map_get(obj_node.obj, key);
    if raw == 0 { return json_make_null(); }
    unsafe {
        return raw as JsonNode;
    }
}

fn json_is_ws(ch: i64) -> i64 {
    if ch == 32 { return 1; }
    if ch == 9  { return 1; }
    if ch == 10 { return 1; }
    if ch == 13 { return 1; }
    return 0;
}

fn json_skip_ws(cur: JsonCursor) -> i64 {
    let mut done = 0;
    while done == 0 {
        if cur.pos >= cur.len {
            done = 1;
        } else {
            let b = str_byte(cur.src, cur.pos);
            if json_is_ws(b) == 1 {
                cur.pos = cur.pos + 1;
            } else {
                done = 1;
            }
        }
    }
    return cur.pos;
}

fn json_parse_string_raw(cur: JsonCursor) -> str {
    if cur.pos >= cur.len { return ""; }
    if str_byte(cur.src, cur.pos) != 34 { return ""; }
    cur.pos = cur.pos + 1;
    let start = cur.pos;
    let first_hit = str_find_any2(cur.src, 34, 92, start);
    if first_hit < 0 {
        cur.pos = cur.len;
        return str_sub(cur.src, start, cur.len - start);
    }
    if str_byte(cur.src, first_hit) == 34 {
        cur.pos = first_hit + 1;
        return str_sub(cur.src, start, first_hit - start);
    }
    let parts = vec_new();
    let mut seg = start;
    let mut p = first_hit;
    let mut done = 0;
    while done == 0 {
        if p > seg {
            let chunk = str_sub(cur.src, seg, p - seg);
            unsafe { vec_push(parts, chunk as i64); }
        }
        let b = str_byte(cur.src, p);
        if b == 34 {
            cur.pos = p + 1;
            done = 1;
        } else {
            if p + 1 < cur.len {
                let nx = str_byte(cur.src, p + 1);
                if nx == 110 { unsafe { vec_push(parts, "\n" as i64); } }
                else if nx == 114 { unsafe { vec_push(parts, "\r" as i64); } }
                else if nx == 116 { unsafe { vec_push(parts, "\t" as i64); } }
                else if nx == 34 { unsafe { vec_push(parts, "\"" as i64); } }
                else if nx == 92 { unsafe { vec_push(parts, "\\" as i64); } }
                else if nx == 47 { unsafe { vec_push(parts, "/" as i64); } }
                else {
                    let cs = str_from_byte(nx);
                    unsafe { vec_push(parts, cs as i64); }
                }
                seg = p + 2;
            } else {
                seg = p + 1;
            }
            if seg >= cur.len {
                cur.pos = cur.len;
                done = 1;
            } else {
                let next_hit = str_find_any2(cur.src, 34, 92, seg);
                if next_hit < 0 {
                    if cur.len > seg {
                        let tail = str_sub(cur.src, seg, cur.len - seg);
                        unsafe { vec_push(parts, tail as i64); }
                    }
                    cur.pos = cur.len;
                    done = 1;
                } else {
                    p = next_hit;
                }
            }
        }
    }
    return str_join(parts, "");
}

fn json_is_num_char(b: i64) -> i64 {
    if b >= 48 {
        if b <= 57 { return 1; }
    }
    if b == 45 { return 1; } // -
    if b == 43 { return 1; } // +
    if b == 46 { return 1; } // .
    if b == 101 { return 1; } // e
    if b == 69  { return 1; } // E
    return 0;
}

fn json_parse_value(cur: JsonCursor) -> JsonNode {
    json_skip_ws(cur);
    if cur.pos >= cur.len { return json_make_null(); }
    let c = str_byte(cur.src, cur.pos);

    if c == 34 {
        return json_make_str(json_parse_string_raw(cur));
    }
    if c == 123 {
        cur.pos = cur.pos + 1;
        let obj = json_make_object();
        json_skip_ws(cur);
        if cur.pos < cur.len {
            if str_byte(cur.src, cur.pos) == 125 {
                cur.pos = cur.pos + 1;
                return obj;
            }
        }
        let mut done = 0;
        while done == 0 {
            json_skip_ws(cur);
            if cur.pos >= cur.len { return obj; }
            if str_byte(cur.src, cur.pos) != 34 { return obj; }
            let key = json_parse_string_raw(cur);
            json_skip_ws(cur);
            if cur.pos < cur.len {
                if str_byte(cur.src, cur.pos) == 58 {
                    cur.pos = cur.pos + 1;
                }
            }
            let val = json_parse_value(cur);
            json_set(obj, key, val);
            json_skip_ws(cur);
            if cur.pos >= cur.len {
                done = 1;
            } else {
                let sep = str_byte(cur.src, cur.pos);
                if sep == 44 {
                    cur.pos = cur.pos + 1;
                } else {
                    if sep == 125 {
                        cur.pos = cur.pos + 1;
                    }
                    done = 1;
                }
            }
        }
        return obj;
    }
    if c == 91 {
        cur.pos = cur.pos + 1;
        let arr = json_make_array();
        json_skip_ws(cur);
        if cur.pos < cur.len {
            if str_byte(cur.src, cur.pos) == 93 {
                cur.pos = cur.pos + 1;
                return arr;
            }
        }
        let mut done = 0;
        while done == 0 {
            json_skip_ws(cur);
            if cur.pos >= cur.len { return arr; }
            let val = json_parse_value(cur);
            json_push(arr, val);
            json_skip_ws(cur);
            if cur.pos >= cur.len {
                done = 1;
            } else {
                let sep = str_byte(cur.src, cur.pos);
                if sep == 44 {
                    cur.pos = cur.pos + 1;
                } else {
                    if sep == 93 {
                        cur.pos = cur.pos + 1;
                    }
                    done = 1;
                }
            }
        }
        return arr;
    }
    if c == 116 {
        cur.pos = cur.pos + 4;
        return json_make_bool(1);
    }
    if c == 102 {
        cur.pos = cur.pos + 5;
        return json_make_bool(0);
    }
    if c == 110 {
        cur.pos = cur.pos + 4;
        return json_make_null();
    }

    let st = cur.pos;
    let mut is_float = 0;
    let mut ndone = 0;
    while ndone == 0 {
        if cur.pos >= cur.len {
            ndone = 1;
        } else {
            let b = str_byte(cur.src, cur.pos);
            if json_is_num_char(b) == 1 {
                if b == 46 { is_float = 1; }
                if b == 101 { is_float = 1; }
                if b == 69 { is_float = 1; }
                cur.pos = cur.pos + 1;
            } else {
                ndone = 1;
            }
        }
    }
    let raw = str_sub(cur.src, st, cur.pos - st);
    if is_float != 0 {
        return json_make_float_str(raw);
    }
    return json_make_int(str_to_i64(raw));
}

fn json_parse(src: str) -> JsonNode {
    let cur = JsonCursor { src: src, len: str_len(src), pos: 0 };
    return json_parse_value(cur);
}

fn json_needs_esc_ch(ch: i64) -> i64 {
    if ch == 34 { return 1; }
    if ch == 92 { return 1; }
    if ch < 32 { return 1; }
    return 0;
}

fn json_escape_str(s: str) -> str {
    let n = str_len(s);
    let parts = vec_new();
    unsafe { vec_push(parts, "\"" as i64); }
    let mut seg = 0;
    let mut k = 0;
    while k < n {
        let ch = str_byte(s, k);
        if json_needs_esc_ch(ch) != 0 {
            if k > seg {
                let sub = str_sub(s, seg, k - seg);
                unsafe { vec_push(parts, sub as i64); }
            }
            if ch == 34 { unsafe { vec_push(parts, "\\\"" as i64); } }
            else if ch == 92 { unsafe { vec_push(parts, "\\\\" as i64); } }
            else if ch == 10 { unsafe { vec_push(parts, "\\n" as i64); } }
            else if ch == 13 { unsafe { vec_push(parts, "\\r" as i64); } }
            else if ch == 9  { unsafe { vec_push(parts, "\\t" as i64); } }
            else {
                let bstr = str_from_byte(ch);
                unsafe { vec_push(parts, bstr as i64); }
            }
            seg = k + 1;
        }
        k = k + 1;
    }
    if seg == 0 {
        return str_concat("\"", str_concat(s, "\""));
    }
    if n > seg {
        let tail = str_sub(s, seg, n - seg);
        unsafe { vec_push(parts, tail as i64); }
    }
    unsafe { vec_push(parts, "\"" as i64); }
    return str_join(parts, "");
}

fn json_stringify_into(node: JsonNode, parts: i64) -> i64 {
    if node.kind == 0 { unsafe { vec_push(parts, "null" as i64); } return 0; }
    if node.kind == 1 {
        if node.bool_val != 0 { unsafe { vec_push(parts, "true" as i64); } }
        else { unsafe { vec_push(parts, "false" as i64); } }
        return 0;
    }
    if node.kind == 2 {
        let s = str_from_i64(node.int_val);
        unsafe { vec_push(parts, s as i64); }
        return 0;
    }
    if node.kind == 3 {
        unsafe { vec_push(parts, node.str_val as i64); }
        return 0;
    }
    if node.kind == 4 {
        let s = json_escape_str(node.str_val);
        unsafe { vec_push(parts, s as i64); }
        return 0;
    }
    if node.kind == 5 {
        let n = vec_len(node.arr);
        unsafe { vec_push(parts, "[" as i64); }
        let mut i = 0;
        while i < n {
            if i > 0 { unsafe { vec_push(parts, "," as i64); } }
            let child = json_at(node, i);
            json_stringify_into(child, parts);
            i = i + 1;
        }
        unsafe { vec_push(parts, "]" as i64); }
        return 0;
    }
    if node.kind == 6 {
        let n = vec_len(node.keys);
        unsafe { vec_push(parts, "{" as i64); }
        let mut i = 0;
        while i < n {
            if i > 0 { unsafe { vec_push(parts, "," as i64); } }
            let k_raw = vec_get(node.keys, i);
            let mut key = "";
            unsafe {
                key = k_raw as str;
            }
            let val = json_get(node, key);
            let ek = json_escape_str(key);
            unsafe {
                vec_push(parts, ek as i64);
                vec_push(parts, ":" as i64);
            }
            json_stringify_into(val, parts);
            i = i + 1;
        }
        unsafe { vec_push(parts, "}" as i64); }
        return 0;
    }
    unsafe { vec_push(parts, "null" as i64); }
    return 0;
}

fn json_stringify(node: JsonNode) -> str {
    let parts = vec_new();
    json_stringify_into(node, parts);
    return str_join(parts, "");
}
