// Vortex Standard Library: std/env
// CLI arguments, environment variables, and wall-clock time helpers

fn env_argc() -> i64 {
    return args_count();
}

fn env_arg(idx: i64) -> str {
    return args_get(idx);
}

fn env_var(name: str) -> str {
    return env_get(name);
}

fn env_var_or(name: str, fallback: str) -> str {
    if env_has(name) != 0 {
        return env_get(name);
    }
    return fallback;
}

fn env_exists(name: str) -> i64 {
    return env_has(name);
}

fn time_now_ms() -> i64 {
    return unix_now_ms();
}

fn time_sleep_ms(ms: i64) -> i64 {
    return sleep_ms(ms);
}
